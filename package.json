{
  "name": "overnote",
  "description": "Context-aware notes and annotations app",
  "author": "Eric Lantz",
  "version": "1.0.0",
  "main": "src/main.js",
  "scripts": {
    "start": "NODE_ENV=development electron .",
    "build": "electron-builder --mac"
  },
  "build": {
    "appId": "com.ericlantz.overnote",
    "productName": "Overnote",
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac..plist",
      "identity": "Eric Lantz (B48SRLN4E7)"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      {
        "from": "../overnote_back/dist",
        "to": "backend",
        "filter": [
          "run_backend"
        ]
      },
      {
        "from": "public/build-helpers",
        "to": "build-helpers"
      }
    ],
    "extraResources": [
      {
        "from": "../overnote_back/dist/run_backend",
        "to": "backend/run_backend"
      },
      {
        "from": "build-helpers/GetWindowInfo",
        "to": "build-helpers/GetWindowInfo"
      }
    ]
  },
  "dependencies": {
    "node": "^20.13.1",
    "quill": "^2.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

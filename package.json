{
  "name": "overnote_frontend",
  "version": "1.0.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.overnote.app",
    "productName": "Overnote",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "public/icon.png",
      "identity": "Overnote Development",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "../overnote_back/dist/run_backend",
      {
        "from": "../overnote_back/postgres",
        "to": "postgres"
      }
    ],
    "extraResources": [
      {
        "from": "../overnote_back/dist/run_backend",
        "to": "run_backend"
      },
      {
        "from": "../overnote_back/postgres",
        "to": "postgres"
      }
    ]
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "get-windows": "^9.2.0",
    "node": "^20.19.0",
    "quill": "^2.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "vite": "^6.0.7"
  }
}
